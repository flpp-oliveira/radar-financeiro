// Publicação na Cloudflare (Workers com arquivos estáticos).
// Deploy: `npm run deploy` (local) ou o workflow do GitHub Actions.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "radar-financeiro",
  "main": "worker/index.js",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Todo acesso passa pelo worker, para ficar registrado nos logs.
    "run_worker_first": true,
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  },
  // Observabilidade: logs de cada requisição (Workers Logs) e métricas no
  // painel da Cloudflare (Workers & Pages > radar-financeiro > Observability).
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
