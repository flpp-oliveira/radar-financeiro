---
// Cabeçalho das páginas internas: uma linha pequena (eyebrow), o título e
// um subtítulo, sobre um fundo de pontinhos (DotPattern, Magic UI).
import { DotPattern } from '@/components/ui/dot-pattern'

interface Props {
  eyebrow?: string
  title: string
  subtitle?: string
}
const { eyebrow, title, subtitle } = Astro.props
---

<div class="relative isolate mb-8 overflow-hidden rounded-none bg-card px-6 py-8 ring-1 ring-foreground/10 sm:px-8">
  <DotPattern
    width={18}
    height={18}
    cr={1}
    className="-z-10 text-foreground/10 [mask-image:linear-gradient(to_left,white,transparent_70%)]"
  />
  <div class="pointer-events-none absolute -top-24 -right-20 -z-10 size-80 rounded-full bg-linear-to-br from-primary/25 to-info/15 blur-3xl"></div>
  {eyebrow && <p class="text-xs font-medium tracking-widest text-primary uppercase">{eyebrow}</p>}
  <h1 class="mt-2 font-heading text-3xl font-bold tracking-tight sm:text-4xl">{title}</h1>
  {subtitle && <p class="mt-2 max-w-3xl text-muted-foreground">{subtitle}</p>}
  <slot />
</div>
