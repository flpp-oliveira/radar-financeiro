---
// Marca: um radar (anéis + varredura girando + um "blip") e o nome.
// A varredura usa a animação radar-sweep definida em global.css.
interface Props {
  compact?: boolean
  class?: string
}
const { compact = false, class: className = '' } = Astro.props

// "Blips": cada um fica num rumo (graus, sentido horário a partir do topo) e
// muda de distância do centro a cada volta, como um alvo se movendo. Ele
// acende no instante em que a varredura passa por ele e depois some.
const VOLTA = 4 // segundos por volta (igual a radar-sweep)
const BORDA = 45 // a borda da frente da varredura começa a 45°
const blips = [
  { rumo: 60, posicoes: [[60, 11], [56, 7.5], [64, 4]] },
  { rumo: 170, posicoes: [[170, 5], [175, 9], [166, 12.5]] },
  { rumo: 290, posicoes: [[290, 12], [284, 8], [295, 10]] },
].map(({ rumo, posicoes }) => {
  const xy = posicoes.map(([graus, raio]) => {
    const rad = (graus * Math.PI) / 180
    return `${(16 + raio * Math.sin(rad) - 2.5).toFixed(2)}px ${(16 - raio * Math.cos(rad) - 2.5).toFixed(2)}px`
  })
  const atraso = ((((rumo - BORDA) / 360) * VOLTA + VOLTA) % VOLTA).toFixed(2)
  return `--p1:${xy[0]};--p2:${xy[1]};--p3:${xy[2]};animation-delay:${atraso}s`
})
---

<span class:list={['inline-flex items-center gap-2.5', className]}>
  <span class="relative inline-block size-8 shrink-0">
    <svg viewBox="0 0 32 32" class="absolute inset-0 size-8" aria-hidden="true">
      <circle cx="16" cy="16" r="15" class="fill-primary/10 stroke-primary/40" stroke-width="1" />
      <circle cx="16" cy="16" r="10" class="fill-none stroke-primary/30" stroke-width="1" />
      <circle cx="16" cy="16" r="5" class="fill-none stroke-primary/30" stroke-width="1" />
      <path d="M16 1v30M1 16h30" class="stroke-primary/15" stroke-width="1" />
    </svg>
    <svg
      viewBox="0 0 32 32"
      class="absolute inset-0 size-8 origin-center animate-radar-sweep motion-reduce:animate-none"
      aria-hidden="true"
    >
      <defs>
        <linearGradient id="sweep" x1="16" y1="16" x2="16" y2="1" gradientUnits="userSpaceOnUse">
          <stop offset="0" stop-color="var(--color-info)" stop-opacity="0.9" />
          <stop offset="1" stop-color="var(--color-info)" stop-opacity="0" />
        </linearGradient>
      </defs>
      <path d="M16 16 L16 1 A15 15 0 0 1 26.6 5.4 Z" fill="url(#sweep)" />
    </svg>
    {blips.map((estilo) => <span class="blip bg-info shadow-[0_0_6px] shadow-info" style={estilo} />)}
  </span>
  {
    !compact && (
      <span class="leading-none">
        <span class="block font-heading text-[17px] font-bold tracking-tight">
          Radar <span class="text-primary">Financeiro</span>
        </span>
        <span class="mt-1 block text-[10px] font-medium tracking-widest text-muted-foreground uppercase">
          Dados abertos do Banco Central
        </span>
      </span>
    )
  }
</span>

<style>
  .blip {
    position: absolute;
    top: 0;
    left: 0;
    width: 5px;
    height: 5px;
    border-radius: 9999px;
    opacity: 0;
    translate: var(--p1);
    /* Acende a cada volta (4s) e troca de lugar a cada volta (12s = 3 posições). */
    animation:
      blip-acende 4s ease-out infinite,
      blip-move 12s linear infinite;
    /* animation-delay vem do style de cada blip (sincroniza com a varredura). */
  }
  @keyframes blip-acende {
    0% { opacity: 1; scale: 1.6; }
    12% { opacity: 1; scale: 1; }
    75%, 100% { opacity: 0; scale: 0.8; }
  }
  @keyframes blip-move {
    0%, 33.32% { translate: var(--p1); }
    33.33%, 66.65% { translate: var(--p2); }
    66.66%, 100% { translate: var(--p3); }
  }
  @media (prefers-reduced-motion: reduce) {
    .blip {
      animation: none;
      opacity: 1;
    }
  }
</style>
